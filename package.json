{
  "name": "dsh-peakrate",
  "version": "0.1.0",
  "description": "DSH plugin: per-provider peak/off-peak rate badges and switch countdown inside the model selector. Unlike DeepSeek-only peak indicators, it judges each provider by its own time zone and schedule.",
  "type": "module",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "peak",
    "off-peak",
    "pricing",
    "model-selector"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "src",
    "data",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:types && npm run build:host && npm run build:client",
    "build:types": "tsc -p tsconfig.build.json",
    "build:host": "esbuild src/index.ts --bundle --platform=node --format=esm --external:@deepseek-ai/* --outfile=lib/index.js",
    "build:client": "esbuild src/client/index.tsx --bundle --platform=browser --format=esm --external:react --external:@deepseek-ai/* --loader:.css=text --outfile=lib/client.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
